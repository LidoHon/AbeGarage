{
  "name": "Abe-garage",
  "version": "1.0.0",
  "description": "A garage management system",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm start",
    "test": "jest --coverage",
    "test:backend": "cross-env DOTENV_CONFIG_PATH=./backend/.env jest --roots ./backend",
    "test:frontend": "cross-env NODE_ENV=test jest --roots ./frontend"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "node"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.19",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "react-bootstrap": "^2.10.4",
    "save": "^2.9.0"
  }
}
